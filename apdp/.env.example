# ── MTN MoMo ──────────────────────────────────────────────
MTN_COLLECTIONS_SUBSCRIPTION_KEY=your_collections_primary_key
MTN_DISBURSEMENTS_SUBSCRIPTION_KEY=your_disbursements_primary_key
MTN_API_USER_ID=your_api_user_id
MTN_API_KEY=your_api_key
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox

# ── Flutterwave ───────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=your_flw_secret_key
FLUTTERWAVE_PUBLIC_KEY=your_flw_public_key
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_secret_hash

# ── Paystack ──────────────────────────────────────────────
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# ── Monnify ──────────────────────────────────────────────
MONNIFY_API_KEY=your_monnify_api_key
MONNIFY_SECRET_KEY=your_monnify_secret_key
MONNIFY_CONTRACT_CODE=your_contract_code
MONNIFY_BASE_URL=https://sandbox.monnify.com

# ── Kafka ─────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Exchange Rate API ─────────────────────────────────────
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key
EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6

# ── Postgres (for dbt) ────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payment_platform
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=your_password

# ── App ───────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

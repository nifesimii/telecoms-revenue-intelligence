ANTHROPIC_API_KEY=your_anthropic_api_key_here
PRESTO_HOST=your_presto_host_here
PRESTO_PORT=8080
PRESTO_USER=your_presto_username_here
PRESTO_PASSWORD=your_presto_password_here
PRESTO_CATALOG=hive5
PRESTO_SCHEMA=development
USE_SAMPLE_DATA=true
CORS_ORIGINS=http://localhost:5173

# --- Payment Intelligence source --------------------------------------------
# "simulated" (default) → backend/data/samples/payment_simulation.csv
# "apdp"                → APDP normalized.partner_settlements view (live)
# Falls back to "simulated" on any other value.
PAYMENT_SOURCE=simulated

# --- APDP Postgres (only used when PAYMENT_SOURCE=apdp) ---------------------
# These default to APDP's docker-compose values. Override for staging / prod.
APDP_PG_HOST=localhost
APDP_PG_PORT=5432
APDP_PG_DB=payment_platform
APDP_PG_USER=platform_user
APDP_PG_PASSWORD=platform_pass

ANTHROPIC_API_KEY=your_anthropic_api_key_here
PRESTO_HOST=your_presto_host_here
PRESTO_PORT=8080
PRESTO_USER=your_presto_username_here
PRESTO_PASSWORD=your_presto_password_here
PRESTO_CATALOG=hive5
PRESTO_SCHEMA=development
USE_SAMPLE_DATA=true
CORS_ORIGINS=http://localhost:5173

# --- Demo logins --------------------------------------------------------------
# Required: without both values nobody can sign in. Choose your own passwords and
# keep DEMO_LOGINS on one line. Partner logins need an account_code.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_SESSION_SECRET=your_random_signing_secret_here
DEMO_LOGINS=[{"username":"finance","password":"choose_a_password","role":"internal"},{"username":"partner-296065","password":"choose_a_password","role":"partner","account_code":"296065"},{"username":"partner-353072","password":"choose_a_password","role":"partner","account_code":"353072"},{"username":"partner-74050","password":"choose_a_password","role":"partner","account_code":"74050"},{"username":"partner-98052","password":"choose_a_password","role":"partner","account_code":"98052"},{"username":"partner-205044","password":"choose_a_password","role":"partner","account_code":"205044"},{"username":"partner-295083","password":"choose_a_password","role":"partner","account_code":"295083"}]

# --- Payment Intelligence source --------------------------------------------
# "simulated" (default) → backend/data/samples/payment_simulation.csv
# "apdp"                → APDP normalized.partner_settlements view (live)
# Falls back to "simulated" on any other value.
PAYMENT_SOURCE=simulated

# --- APDP Postgres (only used when PAYMENT_SOURCE=apdp) ---------------------
# These default to APDP's docker-compose values. Override for staging / prod.
APDP_PG_HOST=localhost
APDP_PG_PORT=5432
APDP_PG_DB=payment_platform
APDP_PG_USER=platform_user
APDP_PG_PASSWORD=platform_pass

# --- FBB audit Postgres (dedicated — holds zero-commission audit trails) ----
# Started by the FBB docker-compose.yml (fbb-postgres). Host port 5544 to
# avoid clashing with APDP's 5432 / a local Postgres.
FBB_AUDIT_PG_HOST=localhost
FBB_AUDIT_PG_PORT=5544
FBB_AUDIT_PG_DB=fbb_audit
FBB_AUDIT_PG_USER=fbb_audit
FBB_AUDIT_PG_PASSWORD=fbb_audit_pass
